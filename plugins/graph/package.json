{
  "name": "graph",
  "version": "0.1.0",
  "type": "module",
  "description": "Local Graph wrapper that decodes percent-encoded Quartz slugs.",
  "exports": {
    ".": "./index.js",
    "./components": "./components/index.js"
  },
  "peerDependencies": {
    "@quartz-community/graph": "^0.1.0"
  },
  "quartz": {
    "name": "graph",
    "displayName": "Graph",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "localGraph": {
        "drag": true,
        "zoom": true,
        "depth": 1,
        "scale": 1.1,
        "repelForce": 0.5,
        "centerForce": 0.3,
        "linkDistance": 30,
        "fontSize": 0.6,
        "opacityScale": 1,
        "showTags": true,
        "removeTags": [],
        "focusOnHover": false,
        "enableRadial": false
      },
      "globalGraph": {
        "drag": true,
        "zoom": true,
        "depth": -1,
        "scale": 0.9,
        "repelForce": 0.5,
        "centerForce": 0.2,
        "linkDistance": 30,
        "fontSize": 0.6,
        "opacityScale": 1,
        "showTags": true,
        "removeTags": [],
        "focusOnHover": true,
        "enableRadial": true
      }
    },
    "components": {
      "Graph": {
        "displayName": "Graph",
        "defaultPosition": "right",
        "defaultPriority": 10
      }
    },
    "optionSchema": {
      "localGraph": {
        "type": "object"
      },
      "globalGraph": {
        "type": "object"
      }
    }
  }
}
